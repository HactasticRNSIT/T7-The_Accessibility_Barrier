# =============================================
# Arogya Dwaar — Environment Variables Example
# Copy this file to .env.local and fill in values
# =============================================

# --- API Base URL (backend, if you add one) ---
VITE_API_BASE_URL=http://localhost:4000/api

# --- Google Maps / Geolocation (optional) ---
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# --- eSanjeevani portal URL ---
VITE_ESANJEEVANI_URL=https://esanjeevani.mohfw.gov.in

# --- PM-JAY eligibility API (optional backend integration) ---
VITE_PMJAY_API_URL=https://api.pmjay.gov.in

# --- Emergency SMS gateway (optional backend integration) ---
VITE_SMS_API_KEY=your_sms_gateway_key
VITE_EMERGENCY_CONTACT_NUMBER=108

# --- Feature flags ---
VITE_ENABLE_VOICE_ASSISTANT=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_TELEMEDICINE=true
